{
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(pip install *)",
      "Bash(python -m bench.run *)",
      "PowerShell(git push *)",
      "PowerShell(pip install *)",
      "PowerShell(python -m bench.run *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "Edit(./data/**)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "PowerShell(git commit --no-verify *)",
      "PowerShell(git commit -n *)"
    ]
  }
}
